<types> <!--pasted from common-types.xml - XInclude not working for me-->
    <composite name="messageHeader" description="Message identifiers and length of message root.">
        <type name="blockLength" primitiveType="uint16"/>
        <type name="templateId" primitiveType="uint16"/>
        <type name="schemaId" primitiveType="uint16"/>
        <type name="version" primitiveType="uint16"/>
    </composite>
    <composite name="groupSizeEncoding" description="Repeating group dimensions.">
        <type name="blockLength" primitiveType="uint16"/>
        <type name="numInGroup" primitiveType="uint16"/>
    </composite>
    <composite name="varStringEncoding" description="Variable length UTF-8 String.">
        <type name="length" primitiveType="uint32" maxValue="1073741824"/>
        <type name="varData" primitiveType="uint8" length="0" characterEncoding="UTF-8"/>
    </composite>
    <composite name="varAsciiEncoding" description="Variable length ASCII String.">
        <type name="length" primitiveType="uint32" maxValue="1073741824"/>
        <type name="varData" primitiveType="uint8" length="0" characterEncoding="ASCII"/>
    </composite>
    <composite name="varDataEncoding" description="Variable length binary blob.">
        <type name="length" primitiveType="uint32" maxValue="1073741824"/>
        <type name="varData" primitiveType="uint8" length="0"/>
    </composite>
</types>

<types>	
	<enum name="BooleanType" encodingType="uint8" description="Boolean Type">
		<validValue name="FALSE" description="False value representation.">0</validValue>
		<validValue name="TRUE" description="True value representation.">1</validValue>
	</enum>
	
	<enum name="SideType" encodingType="char" description="see SideType.java">
		<validValue name="BUY" description="Buy side">B</validValue>
		<validValue name="SELL" description="Sell side">S</validValue>
	</enum>
	
	<enum name="CancelReasonType" encodingType="uint8" description="See CancelReasonType.java">
		<validValue name="REQUESTED">1</validValue>
		<validValue name="SUPERVISORY">2</validValue>
	</enum>

	<enum name="InstrumentSummaryEnum" encodingType="uint8" description="See InstrumentSummaryEnum.java">
		<validValue name="SESSION" >1</validValue>
		<validValue name="BOOK">2</validValue>
	</enum>
	
<enum name="MarketMechanismType" encodingType="uint8" description="See MarketMechanismType.java">
	<validValue name="MMT_ORDERBOOK">1</validValue>
	<validValue name="MMT_AUCTION">2</validValue>
	<validValue name="MMT_QUOTE_DRIVEN">3</validValue>
	<validValue name="MMT_RFQ">4</validValue>
	<validValue name="MMT_OFF_BOOK">5</validValue>
	<validValue name="CTS_SPOT">6</validValue>
	<validValue name="CTS_RTP">7</validValue>
	<validValue name="CTS_AUTOSETTLE">8</validValue>
</enum>
	
<enum name="MmtLevelTwoPhase" encodingType="uint8" description="See MmtLevelTwoPhase.java">
	<validValue name="PreTrading">1</validValue>
	<validValue name="OpeningOrOpeningAuction">2</validValue>
	<validValue name="Continuous">3</validValue>
	<validValue name="ClosingOrClosingAuction">4</validValue>
	<validValue name="PostTrading">5</validValue>
	<validValue name="ScheduleIntradayAuction">6</validValue>
	<validValue name="Quiescent">7</validValue>
	<validValue name="AnyAuction">8</validValue>
	<validValue name="UnscheduleddIntradayAuction">9</validValue>
</enum>

<enum name="NegotiationType" encodingType="uint8" description="See NegotiationType.java">
	<validValue name="AS_REQUESTED">1</validValue>
	<validValue name="PRIVATE_ONLY">2</validValue>
	<validValue name="PUBLIC_ONLY">3</validValue>
</enum>

<enum name="ResourceDesignatorType" encodingType="uint8" description="See ResourceDesignatorType.java">
	<validValue name="POWER">1</validValue>
	<validValue name="ENERGY">2</validValue>
	<validValue name="TRANSPORT">3</validValue>
	<validValue name="WATER_PRESSURE">4</validValue>
	<validValue name="WATER_FLOW">5</validValue>
	<validValue name="GAS_PRESSURE">6</validValue>
	<validValue name="GAS_FLOW">7</validValue>
	<validValue name="BANDWIDTH">8</validValue>
</enum>

<enum name="ResponseDetailType" encodingType="uint8" description="See ResponseDetailType.java">
	<validValue name="UNSPECIFIED">1</validValue>
	<validValue name="RULES_VIOLATION">2</validValue>
	<validValue name="INVALID_REFERENCE">3</validValue>
	<validValue name="DUPLICATE">4</validValue>
	<validValue name="TRADING_CLOSED">5</validValue>
	<validValue name="PARTY_RESTRICTED">6</validValue>
	<validValue name="INVALID_INSTRUMENT">7</validValue>
	<validValue name="FORCE_MAJEURE">8</validValue>
	<validValue name="INVALID_MARKET">9</validValue>
	<validValue name="INVALID_SEGMENT">10</validValue>
	<validValue name="SUCCESS">11</validValue>
	<validValue name="NOT_AUTHORIZED">12</validValue>
	<validValue name="INVALID_ARTIFACT">13</validValue>
</enum>

<enum name="SegmentStatusType" encodingType="uint8" description="See SegmentStatusType.java">
	<validValue name="ACTIVE">1</validValue>
	<validValue name="INACTIVE">2</validValue>
	<validValue name="PUBLISHED">3</validValue>
</enum>

<enum name="SessionStatusType" encodingType="uint8" description="See SessionStatusType.java">
	<validValue name="UNKNOWN">1</validValue>
	<validValue name="HALTED">2</validValue>
	<validValue name="OPEN">3</validValue>
	<validValue name="CLOSED">4</validValue>
	<validValue name="PREOPEN">5</validValue>
	<validValue name="PRECLOSE">6</validValue>
</enum>

<enum name="StreamTradingType" encodingType="uint8" description="See StreamTradingType.java">
	<validValue name="ST_PROHIBITED">1</validValue>
	<validValue name="ST_PERMITTED">2</validValue>
	<validValue name="ST_REQUIRED">3</validValue>
</enum>

<enum name="SubscriptionActionType" encodingType="uint8" description="See SubscriptionActionType.java">
	<validValue name="SNAPSHOT">1</validValue>
	<validValue name="SNAPSHOT_AND_UPDATES">2</validValue>
	<validValue name="CANCEL">3</validValue>
</enum>

<enum name="TickerType" encodingType="uint8" description="See TickerType.java">
	<validValue name="QUOTES">1</validValue>
	<validValue name="RFQS">2</validValue>
	<validValue name="TENDERS">3</validValue>
	<validValue name="TRANSACTIONS">4</validValue>
</enum>



<enum name="UpdateType" encodingType="uint8" description="See UpdateType.java">
	<validValue name="FULL">1</validValue>
	<validValue name="INCREMENTAL">2</validValue>ƒeitend
</enum>


	
	<!--In the following maxValue="1073741824" seems like it should be  larger; 
		 These are java unsigned or signed long which is 2**63 - 
		Encoding works as uint because in the implementation IDs are > 0
		Note that the UID is iniherted from UidType
	-->
	
	<type name="ActorIdType" primitiveType="uint64" />
	<type name="MarketIdType" primitiveType="uint64" />
	<type name="MarketOrderIdType" primitiveType="uint64" />
	<type name="MarketTransactionIdType" primitiveType="uint64" />
	<type name="MeasurementPointIdType" primitiveType="uint64" />
	<type name="RefIdType" primitiveType="uint64" />
	<type name="RfqIdType" primitiveType="uint64" />
	<type name="TenderIdType" primitiveType="uint64" />
	<type name="TransactionIdType" primitiveType="uint64" />
	<type name="WarrantIdType" primitiveType="uint64" />
	<type name="RecipientTransactionIdType" primitiveType="uint64"/>
	
	
	<composite name="TenderIntervalDetail" description="See TenderIntervalDetail.java">
    <ref name="interval" type="Interval"/>
    <type name="price" primitiveType="int64"/>
    <type name="quantity" primitiveType="int64"/>
</composite>

<!--Uses updated naming for Instant, Duration, and Interval 20250416-->
	<composite name="Instant" description="See java.time.Instant. Seconds (signed) and nanoseconds (unsiqned)">
		<type name="seconds" primitiveType="int64"></type>
		<type name="nano" primitiveType="uint32"></type>
	</composite>
	
	<composite name="Duration" description="See java.time.Duration. In seconds (signed) and nanoseconds (unsiqned)">
		<type name="seconds" primitiveType="int64"></type>
		<type name="nano" primitiveType="uint32"></type>
	</composite>
	
	<composite name="Interval" description="See Interval.java">
		<ref name="duration" type="Duration" />
		<ref name="dtStart" type="Instant" />
	</composite>
	
	<composite name="BridgeInstant" description="String-formatted ISO 8601 timestamp. See BridgeInstant.java">
		<type name="length" primitiveType="uint32" maxValue="1073741824"/>
		<type name="varData" primitiveType="uint8" length="0" characterEncoding="UTF-8"/>
	</composite>
	
	<composite name="BridgeInterval" description="see BridgeInterval.java">
		<type name="durationInMinutes" primitiveType="uint32" maxValue="1073741824"/>
		<!--duplicates BridgeInstant attributes - can't seem to assemble user-defined types except in messages	-->
		<!--todo: use fixed length string?-->
		<type name="length" primitiveType="uint32" maxValue="1073741824"/>
		<type name="varData" primitiveType="uint8" length="0" characterEncoding="UTF-8"/>
	</composite>
	
	<composite name="EiTenderType" description="See EiTenderType.java">
			<ref name="marketOrderId" type="MarketOrderIdType" />
			<ref name="tenderId" type="TenderIdType" />  
			<ref name="referencedQuoteId" type="MarketOrderIdType" />
			<ref name="tenderBase" type="TenderBase" />
	</composite>
	
	<!--Added tenderBase as an element pending addressing inheritance-->
	<composite name="TenderBase" description="See TenderBase.java" >
		<ref name="allOrNone" type="BooleanType" />
		<!-- 	executionInstructions set to uint64 instead of VarStringEncoding
				as the string typically a couple of  Char or "" -->
		<type name="executionInstructions" primitiveType="uint64" />
		<ref name="expirationTime" type="Instant" />
		<ref name="marketId" type="MarketIdType" />
		<type name="priceScale" primitiveType="uint32" />
		<type name="quantityScale" primitiveType="uint32" />
		<ref  name="resourceDesignator" type="ResourceDesignatorType" />
		<type name="segmentId" primitiveType="uint32" />
		<ref name="side" type="SideType"/>
		<ref  name="tenderDetail" type="TenderIntervalDetail" />
		<ref  name="warrants" type="WarrantIdType" />
	</composite>
	
	<!--First try encoding polymorphism in TenderDetail-->
<!--	<composite name="TenderDetail" description="See TenderDetail.java" >
	<ref name="tenderIntervalDetail" type="TenderIntervalDetail">		</ref>
	<ref name="tenderStreamDetail" type="TenderStreamDetail">		</ref>
	</composite>
	
	<composite name="TenderInterrvalDetail" description="See TenderIntervalDetail.java">
		<ref name="interval" type="Interval"
		<type name="" primitiveType=""></type>
	</composite>

	<composite name="TenderStreamDetail" description="See TenderStreamDetail.java">
		<ref name="interval" type=""
		<type name="" primitiveType=""></type>
	</composite>-->
	
	<composite name="TickerPayloadBase" description="See TickerPayloadBase.java">
		<ref name="counterPartyId" type="ActorIdType" />  
		<ref name="partyId" type="ActorIdType" />
		<ref name="side" type="SideType" />
		<ref name="subscriptionId" type="RefIdType" />
		<ref name="tickerType" type="TickerType" />
	</composite>
	
	<composite name="EiQuoteType" description="See EiQuoteType.java">
		<ref name="marketQuoteId" type="MarketOrderIdType"	/>
		<ref name="privateQuote" type="BooleanType" 	/>
		<ref name="quoteId" type="TenderIdType" 	/>
		<ref name="rfqId" type="RfqIdType" 	/>
		<ref name="tradeable" type="BooleanType" 	/>
		<ref name="tenderBase" type="TenderBase" />
	</composite>
	
	<composite name="EiResponseType" description="See EiResponseType.java">
		<ref name="createdDateTime" type="Instant" />  
		<ref name="inResponseTo" type="RefIdType" />   
		<type name="responseCode" primitiveType="uint64" />  
		<ref name="responseDescription" type="varStringEncoding"/>
		<ref name="responseDetail" type="ResponseDetailType" ></ref>
	</composite>
	
	<composite name="EiSubscriptionRequestType" description="See EiSubscriptionRequestType.java">
		<ref name="marketId" type="MarketIdType" />
		<type name="segmentId" primitiveType="int16" />
		<ref name="subscriptionActionRequested" type="SubscriptionActionType" />
		<ref name="subscriptionRequestId" type="RefIdType" />
	</composite>
	
	<composite name="EiSubscriptionResponseType" description="See EiSubscriptionResponseType.java">
		<ref name="multicastListenReference" type="varStringEncoding" />
		<ref name="response" type="EiResponseType" />
		<ref name="subscriptionActionTaken" type="SubscriptionActionType" />
		<ref name="subscriptionRequestId" type="RefIdType" />
	</composite>
	
	<composite name="EiTransactionType"	description="See EiTransactionType.java">
		<ref name="marketTransactionId" type="MarketTransactionIdType" />
		<ref name="tender" type="EiTenderType" />
	</composite>
	
	<composite name="QuoteTicker" description="See QuoteTickerType.jav">
		<ref name="quote" type="EiQuoteType"  />
	</composite>

	

	
</types>
	
