<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe" xmlns:xi="http://www.w3.org/2001/XInclude" 
	package="org.theenergymashuplab.cts.generated_files" id="1" version="2" semanticVersion="2.1"
	description="Phase 1 CTS PR05 Types and Payloads."
	byteOrder="littleEndian" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://fixprotocol.io/2016/sbe http://fixprotocol.io/2016/sbe.xsd">
	
